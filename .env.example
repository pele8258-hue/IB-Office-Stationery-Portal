# Oracle Database
DB_USER=your_username
DB_PASSWORD=your_password
DB_CONNECT_STRING=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=your_host)(PORT=1521))(CONNECT_DATA=(SID=your_sid)))

# JWT
JWT_SECRET=change_this_secret

# SMTP — Email Sender (for document expiry notifications)
# Gmail example: host=smtp.gmail.com, port=587, secure=false, use App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Admin SVS <your_email@gmail.com>
